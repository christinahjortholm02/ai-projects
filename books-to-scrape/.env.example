# Copy this file to .env and fill in your own values. Never commit .env.
#
# SUPABASE_SECRET_KEY is ONLY for supabase_books.py (runs on your own machine).
# It bypasses row level security: NEVER put it in any HTML file.
# catalogue.html uses the separate PUBLISHABLE key instead.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
